{
  "name": "codex-plus-plus",
  "version": "0.1.0",
  "private": true,
  "description": "Local BYOK desktop workspace with bundled app server and plugins",
  "author": "Codex++ contributors",
  "main": "electron/main.js",
  "scripts": {
    "check": "tsc --noEmit",
    "build": "vite build",
    "start": "electron .",
    "audit:release": "node scripts/audit-release.mjs",
    "dist:win": "pwsh -NoProfile -File scripts/prepare-release.ps1 && electron-builder --config electron-builder.cjs --win portable zip --x64 --publish never"
  },
  "dependencies": {
    "@oai/sky": "file:electron/runtime/sky",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "smol-toml": "^1.4.2"
  },
  "overrides": {
    "minimatch@>=7": "11.0.9"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "electron": "45.4.1",
    "electron-builder": "26.18.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.0"
  }
}
